        {"Sid": "PassRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "*"},
        {"Sid": "SSMAgent", "Effect": "Allow", "Action": ["ssm:SendCommand", "ssm:GetCommandInvocation"], "Resource": "*"}
      ]
    }
  },
  {
    "arn": "arn:aws:iam::123456789012:policy/CodeBuildPolicy",
    "name": "CodeBuildPolicy",
    "policy_doc": {
      "Version": "2012-10-17",
      "Statement": [
        {"Sid": "CodeBuildExecution", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "*"},
        {"Sid": "S3Artifacts", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"], "Resource": "*"},
        {"Sid": "AssumeRoles", "Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "*"}
      ]
    }
  },
  {
    "arn": "arn:aws:iam::123456789012:policy/CodePipelinePolicy",
    "name": "CodePipelinePolicy",
    "policy_doc": {
      "Version": "2012-10-17",
      "Statement": [
        {"Sid": "CodePipelineAccess", "Effect": "Allow", "Action": ["codepipeline:*"], "Resource": "*"},
        {"Sid": "CloudFormation", "Effect": "Allow", "Action": ["cloudformation:CreateStack", "cloudformation:UpdateStack", "cloudformation:DescribeStacks"], "Resource": "*"},
        {"Sid": "PassRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "*"}
      ]
    }
  },
  {
    "arn": "arn:aws:iam::123456789012:policy/GlueS3Access",
    "name": "GlueS3Access",
    "policy_doc": {
      "Version": "2012-10-17",
      "Statement": [
        {"Sid": "S3Access", "Effect": "Allow", "Action": ["s3:GetObject", "s3:ListBucket"], "Resource": "*"},
        {"Sid": "LambdaInvoke", "Effect": "Allow", "Action": ["lambda:InvokeFunction"], "Resource": "*"}
      ]
    }
  },
  {
    "arn": "arn:aws:iam::123456789012:policy/SageMakerS3Access",
    "name": "SageMakerS3Access",
    "policy_doc": {
      "Version": "2012-10-17",
      "Statement": [
        {"Sid": "S3Full", "Effect": "Allow", "Action": ["s3:*"], "Resource": "*"},
        {"Sid": "STSAssumeAdminForDebug", "Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "arn:aws:iam::123456789012:role/AdminRole"}
      ]
    }
  },
  {
    "arn": "arn:aws:iam::123456789012:policy/ECSTaskPolicy",
    "name": "ECSTaskPolicy",
    "policy_doc": {
