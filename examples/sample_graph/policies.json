        {"Sid": "SNSPublish", "Effect": "Allow", "Action": ["sns:Publish"], "Resource": "*"}
      ]
    }
  },
  {
    "arn": "arn:aws:iam::123456789012:policy/DataPipelinePolicy",
    "name": "DataPipelinePolicy",
    "policy_doc": {
