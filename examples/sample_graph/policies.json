        {"Sid": "EC2Manage", "Effect": "Allow", "Action": ["ec2:RunInstances", "ec2:DescribeInstances", "ec2:TerminateInstances"], "Resource": "*"},
        {"Sid": "PassRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "*"}
      ]
    }
  }
