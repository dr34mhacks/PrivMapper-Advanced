      "Statement": [
        {"Sid": "SSMAccess", "Effect": "Allow", "Action": ["ssm:GetParameter", "ssm:GetParameters"], "Resource": "*"},
        {"Sid": "S3Access", "Effect": "Allow", "Action": ["s3:GetObject"], "Resource": "*"}
      ]
    }
  },
  {
    "arn": "arn:aws:iam::123456789012:policy/VendorAccessPolicy",
    "name": "VendorAccessPolicy",
